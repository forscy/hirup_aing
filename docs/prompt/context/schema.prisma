generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  name           String
  role           UserRole        @default(USER) // USER, ADMIN
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activityMaster ActivityMaster[]
  categories     Category[]       // Relasi untuk kategori yang dibuat user
}

enum UserRole {
  USER
  ADMIN
}

model ActivityMaster {
  id             String            @id @default(uuid())
  name           String
  description    String?
  startTime      DateTime          // Waktu mulai (jam:menit:detik)
  endTime        DateTime          // Waktu selesai (jam:menit:detik)
  isRecurring    Boolean           @default(false)
  frequency      Frequency            // "harian", "mingguan", "bulanan"
  // Untuk penjadwalan berulang
  daysOfWeek     Days?           // "1,2,3,4,5,6,7" (1=Senin, 7=Minggu) untuk mingguan
  datesOfMonth   String?           // "1,15,28" untuk bulanan
  daysOfMonth    Days?           // Hari dalam bulan untuk bulanan
  categories     Category[]        @relation("ActivityCategories")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  occurrences    ActivityInstance[]
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum Days {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ActivityInstance {
  id              String        @id @default(uuid())
  activityDate    DateTime      // Tanggal spesifik kemunculan
  status          ActivityStatus @default(PENDING)        // "Belum", "Selesai", "Ditunda", "Batalkan"
  notes           String?       // Catatan khusus untuk kemunculan ini
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activityMasterId String
  activityMaster  ActivityMaster @relation(fields: [activityMasterId], references: [id], onDelete: Cascade)
}

enum ActivityStatus {
  PENDING
  COMPLETED
  POSTPONED
  CANCELLED
}

model Category {
  id             String          @id @default(uuid())
  name           String
  activities     ActivityMaster[] @relation("ActivityCategories")
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  
  @@unique([name, userId])  // Memastikan nama kategori unik per user
  @@index([userId])         // Index untuk performa query
}
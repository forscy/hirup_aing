generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activityMaster ActivityMaster[]
}

model ActivityMaster {
  id             String            @id @default(uuid())
  name           String
  description    String?
  startTime      DateTime          // Waktu mulai (jam:menit:detik)
  endTime        DateTime          // Waktu selesai (jam:menit:detik)
  isRecurring    Boolean           @default(false)
  frequency      String            // "harian", "mingguan", "bulanan"
  // Untuk penjadwalan berulang
  daysOfWeek     String?           // "1,2,3,4,5,6,7" (1=Senin, 7=Minggu) untuk mingguan
  datesOfMonth   String?           // "1,15,28" untuk bulanan
  daysOfMonth    String?           // Hari dalam bulan untuk bulanan
  categories     Category[]        @relation("ActivityCategories")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  occurrences    ActivityInstance[]
}

model ActivityInstance {
  id              String        @id @default(uuid())
  activityDate    DateTime      // Tanggal spesifik kemunculan
  status          String        // "Belum", "Selesai", "Ditunda", "Batalkan"
  notes           String?       // Catatan khusus untuk kemunculan ini
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activityMasterId String
  activityMaster  ActivityMaster @relation(fields: [activityMasterId], references: [id], onDelete: Cascade)
}

model Category {
  id             String          @id @default(uuid())
  name           String          @unique
  activities     ActivityMaster[] @relation("ActivityCategories")
}